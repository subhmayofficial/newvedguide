# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for chat session creation, system messages, countdown sync, and admin live consult API.
SUPABASE_SERVICE_ROLE_KEY=

# DB: wallet + live chat need migrations 026–031; wallet Razorpay recharge needs 042_wallet_recharge_intents.sql.

# Obscure public URL paths for staff consoles (no leading slash). Change in production.
# Commerce admin: https://yourdomain.com/{ADMIN_PANEL_PATH}/login
# Live chat ops: https://yourdomain.com/{ASTRO_OPS_PATH}
NEXT_PUBLIC_ADMIN_PANEL_PATH=vg-console-8f3k2p
NEXT_PUBLIC_ASTRO_OPS_PATH=vg-astral-9m4q1x
# Server-only overrides (optional; NEXT_PUBLIC_* is used for links in the UI)
ADMIN_PANEL_PATH=
ASTRO_OPS_PATH=

# Comma-separated emails allowed to access the admin panel. If unset, defaults to admin@vedguide.com only.
# Add more: ADMIN_EMAIL_ALLOWLIST=admin@vedguide.com,ops@vedguide.com
# Or set app_metadata.vedguide_admin = true on a user in Supabase.
ADMIN_EMAIL_ALLOWLIST=

# Wallet: if Razorpay keys are set, users always get Razorpay checkout (local dev too).
# Set true only to force fake instant balance (ignores real payments even when keys exist).
ALLOW_TEST_WALLET_TOPUP=

# ============================================
# RAZORPAY
# ============================================
# Test: rzp_test_* / Live: rzp_live_* — Key ID must match between server and checkout.
# Wallet recharge returns RAZORPAY_KEY_ID to the browser (same key used to create orders).
#
# Live account while keeping test vars elsewhere: set RAZORPAY_USE_LIVE=true and fill:
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_USE_LIVE=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same Key ID as RAZORPAY_KEY_ID (needed at build for kundli/consultation checkout).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_GA_ID=

# ============================================
# SITE
# ============================================
# Production: https://yourdomain.com
# Local dev: optional — if unset or localhost, metadata uses http://localhost:$PORT (default 3000).
# Avoid NEXT_PUBLIC_SITE_URL=http://localhost:7071 unless the app actually listens there.
NEXT_PUBLIC_SITE_URL=https://vedguide.com
# Digits only, with country code (e.g. 919876543210) — used for consultation WhatsApp CTAs
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ============================================
# DELIVERY INTEGRATIONS
# ============================================
# Interakt (WhatsApp API). Omitted = on when INTERAKT_API_KEY is set. Set INTERAKT_ENABLED=false to force off.
INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/
INTERAKT_TEMPLATE_LIST_API_URL=
# Secret key only (from Developer settings). Do not prefix "Basic " — the app adds it.
INTERAKT_API_KEY=
INTERAKT_TEMPLATE_NAME=order_paid_update
INTERAKT_TEMPLATE_LANGUAGE=en
INTERAKT_COUNTRY_CODE=+91
INTERAKT_AUTO_DELIVERY_ON_PAYMENT=true
# Paid kundli only — template with body {{1}} = name, button URL {{1}} (see migration 013)
INTERAKT_KUNDLI_TEMPLATE_NAME=kundlidelivery_bt
INTERAKT_KUNDLI_TEMPLATE_LANG=hi
# First URL button is usually index 0; set 1 if Interakt shows a different index
INTERAKT_KUNDLI_BUTTON_INDEX=0
# Optional full URL; use {order_number} and/or {order_id}. If unset: NEXT_PUBLIC_SITE_URL + /kundli-report
# INTERAKT_KUNDLI_BUTTON_LINK=https://vedguide.com/kundli-report

# Resend Email
# If RESEND_ENABLED is omitted, integration auto-enables when RESEND_API_KEY is set.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
EMAIL_SUPPORT_LINK=
RESEND_RETRY_COUNT=2
RESEND_AUTO_DELIVERY_ON_PAYMENT=true

# ============================================
# BUNNY.NET (Storage + CDN) — server only
# ============================================
# Storage zone → FTP & API → Password (READ/WRITE — not read-only; not the Account-wide API key).
# Zone name, region, and public CDN base URL are in Admin → Settings (DB).
BUNNY_STORAGE_API_KEY=
# Optional: if Settings → Storage region is blank, force API host (e.g. sg for Singapore / sg.storage.bunnycdn.com).
BUNNY_STORAGE_REGION=

